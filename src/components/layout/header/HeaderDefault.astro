---
import { siteDetails, ctaDetails, headerNav } from "@/global"
import HeaderLogo from "./_parts/HeaderLogo.astro"
import NavLinks from "./_parts/NavLinks.astro"
import CtaButton from "./_parts/CtaButton.astro"
import { MobileNav } from "./MobileNav"

interface Props {
  sticky?: boolean
  transparent?: boolean
  showCta?: boolean
  class?: string
}

const {
  sticky = true,
  transparent = false,
  showCta = true,
  class: className,
} = Astro.props
---

<header
  id="site-header"
  class:list={[
    "z-50 w-full transition-all duration-300",
    sticky && "sticky top-0",
    transparent
      ? "bg-transparent"
      : "border-b border-border/40 bg-background/80 backdrop-blur-xl supports-backdrop-filter:bg-background/60",
    className,
  ]}
>
  <div
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
  >
    <!-- Logo -->
    <HeaderLogo />

    <!-- Desktop Navigation -->
    <NavLinks links={headerNav} id="desktop-nav" />

    <!-- CTA + Mobile Menu -->
    <div class="flex items-center gap-3">
      {
        showCta && (
          <CtaButton
            href={ctaDetails.primary.href}
            label={ctaDetails.primary.label}
            class="hidden sm:inline-flex"
          />
        )
      }

      <!-- Mobile Sheet Nav -->
      <MobileNav
        client:load
        links={headerNav}
        siteName={siteDetails.name}
        siteLogo={siteDetails.logo}
        cta={showCta ? ctaDetails.primary : undefined}
        showCta={showCta}
      />
    </div>
  </div>
</header>

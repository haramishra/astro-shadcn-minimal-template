---
import { siteDetails, footerNav, socialLinks } from "@/global";

interface Props {
  showSocials?: boolean;
  class?: string;
}

const { showSocials = true, class: className } = Astro.props;

// Flatten all footer nav groups into a single list of links
const inlineLinks = footerNav.flatMap((group) => group.links).slice(0, 6);
---

<footer class:list={["border-t border-border/40", className]} id="site-footer">
  <div
    class="mx-auto flex max-w-7xl flex-col items-center gap-6 px-4 py-8 sm:px-6 md:flex-row md:justify-between lg:px-8"
  >
    <!-- Logo + Copyright -->
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-2" id="footer-logo">
        <img src={siteDetails.logo} alt={siteDetails.name} class="h-7 w-7" />
        <span class="text-sm font-semibold tracking-tight">{siteDetails.name}</span>
      </a>
      <span class="hidden text-border sm:inline">·</span>
      <p class="hidden text-sm text-muted-foreground sm:inline">
        &copy; {new Date().getFullYear()}
      </p>
    </div>

    <!-- Inline Links -->
    <nav class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2" aria-label="Footer navigation">
      {
        inlineLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm text-muted-foreground transition-colors hover:text-foreground"
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Social Icons -->
    {
      showSocials && (
        <div class="flex items-center gap-2" id="footer-social-links">
          {socialLinks.map((social) => (
            <a
              href={social.link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-md p-2 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
              aria-label={`Follow us on ${social.type}`}
            >
              <social.Icon className="h-4 w-4" />
            </a>
          ))}
        </div>
      )
    }
  </div>

  <!-- Mobile-only copyright -->
  <p class="pb-4 text-center text-xs text-muted-foreground sm:hidden">
    &copy; {new Date().getFullYear()} {siteDetails.name}. All rights reserved.
  </p>
</footer>

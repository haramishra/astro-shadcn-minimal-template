---
import FooterBrand from "./_parts/FooterBrand.astro"
import FooterNavColumns from "./_parts/FooterNavColumns.astro"
import FooterBottom from "./_parts/FooterBottom.astro"
import NewsletterBanner from "./_parts/NewsletterBanner.astro"

interface Props {
  showSocials?: boolean
  showNewsletter?: boolean
  class?: string
}

const {
  showSocials = true,
  showNewsletter = true,
  class: className,
} = Astro.props
---

<footer class:list={["border-t border-border/40 bg-muted/30", className]} id="site-footer">
  <!-- CTA / Newsletter Banner -->
  {showNewsletter && <NewsletterBanner />}

  <!-- Standard Footer Content -->
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid grid-cols-2 gap-8 lg:grid-cols-6">
      <FooterBrand showSocials={showSocials} />
      <FooterNavColumns />
    </div>

    <FooterBottom />
  </div>
</footer>

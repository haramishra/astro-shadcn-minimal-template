---
import {
  IconArrowDownRight,
  IconBrandAbstract,
  IconBrandAdobe,
  IconBrandFramer,
  IconBrandWordpress,
} from "@tabler/icons-react"
import { Image } from "astro:assets"
import HeroImage from "@/assets/images/hero.png"
import { buttonVariants } from "@/components/ui/button"
import { ctaDetails } from "@/global"

const { heading, subheading, primaryCta } = ctaDetails.hero
---

<section class="relative py-32">
  <div class="container mx-auto">
    <div class="mx-auto flex max-w-5xl flex-col items-center">
      <div
        class="z-10 mx-auto flex max-w-5xl flex-col items-center gap-6 text-center"
      >
        <a
          href={ctaDetails.banner.href}
          class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold text-foreground transition-colors hover:bg-accent focus:ring-2 focus:ring-ring focus:ring-offset-2 focus:outline-none"
        >
          {ctaDetails.banner.label}
          <IconArrowDownRight className="ml-2 size-4" />
        </a>
        <div class="space-y-8">
          <div class="space-y-4">
            <h1 class="mb-6 text-3xl font-medium text-pretty lg:text-7xl">
              {heading}
            </h1>
            <p class="mx-auto max-w-2xl text-muted-foreground">
              {subheading}
            </p>
            <a
              href={primaryCta.href}
              class={buttonVariants({ variant: "default", size: "cta" })}
              >{primaryCta.label}</a
            >
          </div>
          <Image src={HeroImage} alt="Hero Image" width={1000} height={1000} />
        </div>

        <div class="mt-20 flex flex-col items-center gap-4 lg:mt-40">
          <p class="text-center text-muted-foreground lg:text-left">
            Powering the next generation of digital products
          </p>
          <div class="flex flex-wrap items-center justify-center gap-8">
            <IconBrandWordpress className="size-10 stroke-1" />
            <IconBrandAdobe className="size-10 stroke-1" />
            <IconBrandAbstract className="size-10 stroke-1" />
            <IconBrandFramer className="size-10 stroke-1" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

---
import { siteDetails, ctaDetails, headerNav, layoutDefaults } from "@/global"
import HeaderLogo from "./_parts/HeaderLogo.astro"
import CtaButton from "./_parts/CtaButton.astro"
import { MobileNav } from "./MobileNav"

interface Props {
  transparent?: boolean
  class?: string
}

const {
  transparent = false,
  class: className,
} = Astro.props

const { sticky, showCta } = layoutDefaults.header
---

<header
  id="site-header"
  class:list={[
    "z-50 w-full transition-all duration-300",
    sticky && "sticky top-0",
    transparent
      ? "bg-transparent"
      : "border-b border-border/40 bg-background/80 backdrop-blur-xl supports-backdrop-filter:bg-background/60",
    className,
  ]}
>
  <div
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
  >
    <!-- Logo -->
    <HeaderLogo />

    <!-- CTA only (no desktop nav) -->
    <div class="flex items-center gap-3">
      {
        showCta && (
          <CtaButton
            href={ctaDetails.primary.href}
            label={ctaDetails.primary.label}
          />
        )
      }

      <!-- Mobile Sheet Nav (still available for nav access) -->
      <MobileNav
        client:load
        links={headerNav}
        className="md:inline-flex"
      />
    </div>
  </div>
</header>

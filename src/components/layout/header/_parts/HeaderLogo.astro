---
import { siteDetails } from "@/global"

interface Props {
  /** Additional CSS classes for the logo link */
  class?: string
  /** Logo image size class (default: "h-8 w-8") */
  logoSize?: string
  /** Site name text size class (default: "text-lg") */
  textSize?: string
  id?: string
}

const {
  class: className,
  logoSize = "h-8 w-8",
  textSize = "text-lg",
  id = "header-logo",
} = Astro.props
---

<a
  href="/"
  class:list={[
    "flex items-center gap-2 transition-opacity hover:opacity-80",
    className,
  ]}
  id={id}
>
  <img src={siteDetails.logo} alt={siteDetails.name} class={logoSize} />
  <span class:list={["font-semibold tracking-tight", textSize]}
    >{siteDetails.name}</span
  >
</a>

---
import { siteDetails } from "@/global"
import { Image } from "astro:assets"

interface Props {
  /** Additional CSS classes for the logo link */
  class?: string
  /** Logo image size class (default: "h-8 w-8") */
  logoSize?: string
  /** Site name text size class (default: "text-lg") */
  textSize?: string
  /** Unique id for the element */
  id?: string
  /** Enable hover opacity transition (default: true) */
  withHover?: boolean
}

const {
  class: className,
  logoSize = "h-8 w-8",
  textSize = "text-lg",
  id,
  withHover = true,
} = Astro.props

// Parse logo size class to get numerical width/height for standard Tailwind classes
const sizeMap: Record<string, number> = {
  "h-6": 24, "w-6": 24,
  "h-7": 28, "w-7": 28,
  "h-8": 32, "w-8": 32,
  "h-9": 36, "w-9": 36,
  "h-10": 40, "w-10": 40,
  "h-12": 48, "w-12": 48,
  "h-16": 64, "w-16": 64,
}
const sizeClass = logoSize.split(" ").find(c => c.startsWith("h-") || c.startsWith("w-"))
const widthHeight = sizeClass ? (sizeMap[sizeClass] || 32) : 32
---

<a
  href="/"
  class:list={[
    "flex items-center gap-2",
    withHover && "transition-opacity hover:opacity-80",
    className,
  ]}
  id={id}
>
  <Image
    src={siteDetails.logo}
    alt={siteDetails.name}
    class={logoSize}
    width={widthHeight}
    height={widthHeight}
  />
  <span class:list={["font-semibold tracking-tight", textSize]}
    >{siteDetails.name}</span
  >
</a>

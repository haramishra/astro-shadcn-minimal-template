---
import { ctaDetails, headerNav, layoutDefaults } from "@/global"
import SiteLogo from "@/components/layout/_parts/SiteLogo.astro"
import HeaderWrapper from "./_parts/HeaderWrapper.astro"
import NavLinks from "./_parts/NavLinks.astro"
import CtaButton from "./_parts/CtaButton.astro"
import { MobileNav } from "./MobileNav"

interface Props {
  transparent?: boolean
  class?: string
}

const { showCta } = layoutDefaults.header

// Split nav links into two halves for centered layout
const midpoint = Math.ceil(headerNav.length / 2)
const leftLinks = headerNav.slice(0, midpoint)
const rightLinks = headerNav.slice(midpoint)
---

<HeaderWrapper {...Astro.props}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Mobile: standard row layout -->
    <div class="flex h-16 items-center justify-between md:hidden">
      <SiteLogo id="header-logo-mobile" />

      <MobileNav
        client:load
        links={headerNav}
      />
    </div>

    <!-- Desktop: centered logo with split nav -->
    <div class="hidden h-16 items-center justify-center md:flex">
      <!-- Left Nav -->
      <NavLinks links={leftLinks} ariaLabel="Main navigation (left)" />

      <!-- Center Logo -->
      <SiteLogo class="mx-8" logoSize="h-9 w-9" textSize="text-xl" id="header-logo" />

      <!-- Right Nav + CTA -->
      <nav class="flex items-center gap-1" aria-label="Main navigation (right)">
        <NavLinks links={rightLinks} ariaLabel="Main navigation (right)" class="md:flex" />
        {
          showCta && (
            <CtaButton
              href={ctaDetails.primary.href}
              label={ctaDetails.primary.label}
              class="ml-4"
            />
          )
        }
      </nav>
    </div>
  </div>
</HeaderWrapper>

---
import { siteDetails, ctaDetails, headerNav } from "@/global";
import type { NavLink } from "@/global";
---

<header
  id="site-header"
  class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/80 backdrop-blur-xl supports-backdrop-filter:bg-background/60"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 transition-opacity hover:opacity-80" id="header-logo">
      <img src={siteDetails.logo} alt={siteDetails.name} class="h-8 w-8" />
      <span class="text-lg font-semibold tracking-tight">{siteDetails.name}</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-1 md:flex" id="desktop-nav" aria-label="Main navigation">
      {
        headerNav.map((link: NavLink) => (
          <a
            href={link.href}
            class="relative rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
            data-nav-link
          >
            {link.label}
            {link.badge && (
              <span class="ml-1.5 inline-flex items-center rounded-full bg-primary/10 px-1.5 py-0.5 text-[10px] font-semibold text-primary">
                {link.badge}
              </span>
            )}
          </a>
        ))
      }
    </nav>

    <!-- CTA + Mobile Menu Toggle -->
    <div class="flex items-center gap-3">
      <a
        href={ctaDetails.primary.href}
        class="hidden rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-all hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/25 sm:inline-flex"
        id="header-cta"
      >
        {ctaDetails.primary.label}
      </a>

      <!-- Mobile hamburger -->
      <button
        type="button"
        class="inline-flex items-center justify-center rounded-md p-2 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground md:hidden"
        id="mobile-menu-toggle"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" id="hamburger-icon" />
        </svg>
        <svg class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" id="close-icon" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <nav
    class="hidden border-t border-border/40 md:hidden"
    id="mobile-nav"
    aria-label="Mobile navigation"
  >
    <div class="space-y-1 px-4 pb-4 pt-2">
      {
        headerNav.map((link: NavLink) => (
          <a
            href={link.href}
            class="block rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
      <div class="pt-2">
        <a
          href={ctaDetails.primary.href}
          class="block rounded-md bg-primary px-4 py-2 text-center text-sm font-medium text-primary-foreground transition-all hover:bg-primary/90"
        >
          {ctaDetails.primary.label}
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const mobileNav = document.getElementById("mobile-nav");
  const hamburgerIcon = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");

  toggle?.addEventListener("click", () => {
    const isOpen = mobileNav?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
    hamburgerIcon?.parentElement?.classList.toggle("hidden", isOpen);
    closeIcon?.parentElement?.classList.toggle("hidden", !isOpen);
  });
</script>

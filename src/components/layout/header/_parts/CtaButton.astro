---
interface Props {
  /** Button label text */
  label: string
  /** Button link href */
  href: string
  /** Additional CSS classes */
  class?: string
  id?: string
}

const {
  label,
  href,
  class: className,
  id = "header-cta",
} = Astro.props
---

<a
  href={href}
  class:list={[
    "rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-all hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/25",
    className,
  ]}
  id={id}
>
  {label}
</a>

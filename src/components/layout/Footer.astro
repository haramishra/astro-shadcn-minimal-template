---
import { siteDetails, footerNav, socialLinks } from "@/global";
import type { NavGroup } from "@/global";
---

<footer class="border-t border-border/40 bg-muted/30" id="site-footer">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <!-- Top Section: Brand + Nav Columns -->
    <div class="grid grid-cols-2 gap-8 lg:grid-cols-6">
      <!-- Brand Column -->
      <div class="col-span-2">
        <a href="/" class="flex items-center gap-2" id="footer-logo">
          <img src={siteDetails.logo} alt={siteDetails.name} class="h-8 w-8" />
          <span class="text-lg font-semibold tracking-tight">{siteDetails.name}</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted-foreground">
          {siteDetails.description}
        </p>

        <!-- Social Links -->
        <div class="mt-6 flex items-center gap-3" id="footer-social-links">
          {
            socialLinks.map((social) => (
              <a
                href={social.link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-md p-2 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
                aria-label={`Follow us on ${social.type}`}
              >
                <social.Icon className="h-4 w-4" />
              </a>
            ))
          }
        </div>
      </div>

      <!-- Navigation Columns -->
      {
        footerNav.map((group: NavGroup) => (
          <div>
            <h3 class="text-sm font-semibold tracking-wide text-foreground">
              {group.title}
            </h3>
            <ul class="mt-4 space-y-3">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-border/40 pt-8 sm:flex-row">
      <p class="text-sm text-muted-foreground">
        &copy; {new Date().getFullYear()} {siteDetails.name}. All rights reserved.
      </p>
      <div class="flex items-center gap-4 text-sm text-muted-foreground">
        <a href="/privacy" class="transition-colors hover:text-foreground">Privacy</a>
        <span class="text-border">·</span>
        <a href="/terms" class="transition-colors hover:text-foreground">Terms</a>
        <span class="text-border">·</span>
        <a href="/cookies" class="transition-colors hover:text-foreground">Cookies</a>
      </div>
    </div>
  </div>
</footer>

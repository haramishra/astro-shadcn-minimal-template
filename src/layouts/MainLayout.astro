---
import "@/styles/global.css";
import BaseHead from "./BaseHead.astro";
import Header from "@header";
import Footer from "@footer";

interface Props {
  /** Page title — overrides the default site title */
  title?: string;
  /** Page description for SEO */
  description?: string;
  /** Custom OG image path */
  ogImage?: string;
  /** OG type — defaults to "website" */
  ogType?: "website" | "article";
  /** Twitter card type */
  twitterCard?: "summary" | "summary_large_image";
  /** Canonical URL override */
  canonical?: string;
  /** Robots directive */
  robots?: string;
  /** Meta keywords */
  keywords?: string;
  /** Article publish date (ISO 8601) */
  publishedTime?: string;
  /** Article modified date (ISO 8601) */
  modifiedTime?: string;
  /** Author name */
  author?: string;
  /** Additional classes for the <main> element */
  class?: string;

  // ── Layout Variant Props ──────────────────────────────────────────────
  /** Header variant: "default" | "centered" | "minimal" */
  header?: "default" | "centered" | "minimal";
  /** Footer variant: "default" | "simple" | "cta" */
  footer?: "default" | "simple" | "cta";
  /** Make header transparent (overlay on hero) */
  headerTransparent?: boolean;
}

const {
  class: className,
  header = "default",
  footer = "default",
  headerTransparent = false,
  ...headProps
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead {...headProps} />
  </head>
  <body class="flex min-h-svh flex-col bg-background text-foreground antialiased">
    <!-- Skip to content (a11y) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground"
    >
      Skip to content
    </a>

    <Header variant={header} transparent={headerTransparent} />

    <main id="main-content" class:list={["flex-1", className]}>
      <slot />
    </main>

    <Footer variant={footer} />
  </body>
</html>

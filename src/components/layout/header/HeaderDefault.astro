---
import { siteDetails, ctaDetails, headerNav, layoutDefaults } from "@/global"
import { getImage } from "astro:assets"
import SiteLogo from "@/components/layout/_parts/SiteLogo.astro"
import HeaderWrapper from "./_parts/HeaderWrapper.astro"
import NavLinks from "./_parts/NavLinks.astro"
import CtaButton from "./_parts/CtaButton.astro"
import { MobileNav } from "./MobileNav"

interface Props {
  transparent?: boolean
  class?: string
}

const { showCta } = layoutDefaults.header

// Optimize mobile menu logo
const optimizedLogo = await getImage({
  src: siteDetails.logo,
  width: 28,
  height: 28,
})
---

<HeaderWrapper {...Astro.props}>
  <div
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
  >
    <!-- Logo -->
    <SiteLogo id="header-logo" />

    <!-- Desktop Navigation -->
    <NavLinks links={headerNav} id="desktop-nav" />

    <!-- CTA + Mobile Menu -->
    <div class="flex items-center gap-3">
      {
        showCta && (
          <CtaButton
            href={ctaDetails.primary.href}
            label={ctaDetails.primary.label}
            class="hidden sm:inline-flex"
          />
        )
      }

      <!-- Mobile Sheet Nav -->
      <MobileNav
        client:load
        links={headerNav}
        logoSrc={optimizedLogo.src}
      />
    </div>
  </div>
</HeaderWrapper>
